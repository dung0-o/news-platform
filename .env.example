# Scraper News Sources
API_KEY=your_api_key
RSS_FEED_URL=your_rss_feed_url

# Google Cloud Platform
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name
BQ_DATASET_NAME=your_bq_dataset_name

# Upstash Redis
UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL_ID=distilbert/distilbert-base-uncased-finetuned-sst-2-english

# API Backend (Cloud Run URL)
API_URL=your_cloud_run_url

# Dashboard Defaults
DEFAULT_DAYS=7
DEFAULT_LOOKBACK_DAYS=1
DEFAULT_THRESHOLD=0.5
MAX_COMPANIES=50
