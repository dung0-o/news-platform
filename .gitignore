.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
*.log

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/

