# ============================================================
# dbt (Data Build Tool)
# ============================================================
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
dbt_project/*.db
dbt_project/*.duckdb
dbt_project/*.sqlite
dbt_project/profiles.yml  # Contains credentials!
dbt_project/.user.yml
dbt_project/.dbt/
dbt_project/manifest.json
dbt_project/run_results.json
dbt_project/sources.json

# ============================================================
# Google Cloud / BigQuery Credentials
# ============================================================
*.key.json
*.service-account.json
*.gcp.json
*.credentials.json
service-account-*.json
client_secret_*.json
*.pem
*.p12
*.json
!docs/*.json  # Only exclude root-level JSON, NOT docs

# ============================================================
# Environment Variables & Secrets
# ============================================================
.env
.env.local
.env.*.local
.secrets
secrets/
*.secret
config.local.*
application-local.properties
application-dev.properties
settings.local.py

